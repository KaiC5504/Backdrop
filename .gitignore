# Secrets. Never committed, not even temporarily. Codemagic holds the signing key and
# the App Store Connect key; nothing in this repo needs either.
.env
.env.*
*token*.txt
*.p8
*.p12
*.pem
*.mobileprovision

# Xcode project files are generated from project.yml by XcodeGen on the build machine.
*.xcodeproj
*.xcworkspace
DerivedData/
.swiftpm/
*.xcuserstate
build/

# Generated by XcodeGen from project.yml — Info.plists and entitlements.
ios/Generated/

.DS_Store
Thumbs.db

__pycache__/
